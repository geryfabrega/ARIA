.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# macOS
.DS_Store
.AppleDouble

# Editors
.idea/
.vscode/
*.iml

# Jupyter
.ipynb_checkpoints/
